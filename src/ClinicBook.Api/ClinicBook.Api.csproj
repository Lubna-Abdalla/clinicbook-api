      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClinicBook.Infrastructure\ClinicBook.Infrastructure.csproj" />
  </ItemGroup>

</Project>
